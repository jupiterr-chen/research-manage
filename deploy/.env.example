# agents-manage 部署环境变量模板(R-DEP-02)
# 复制为 deploy/.env 后填写;绝不提交 .env。
# AM_TOKEN 生成:python scripts/gen_token.py

# ---- 鉴权(必填)----
AM_TOKEN=            # ≥32 字符;python scripts/gen_token.py

# ---- 构建用户(按 DEPLOY.md §1 的 stat 查询结果填)----
APP_UID=1000         # stat -c %u:%g /home/chen/docker/TradingAgents/data → uid(NAS 实测 1000)
DOCKER_GID=994       # stat -c %g /var/run/docker.sock(NAS 实测 994)

# ---- 本地 compose.local 才需要(宿主绝对路径;Windows 用 D:/x/y 形式)----
# AM_TA_IMAGE=tradingagents-sim:latest
# AM_TA_DATA_HOST=D:/2.Develop/5.Codex/researcher-agent/Agents-Manage/.local/ta-data
# AM_TA_ENV_HOST=D:/2.Develop/5.Codex/researcher-agent/Agents-Manage/.local/ta.env
# AM_RUNNER_HOST=D:/2.Develop/5.Codex/researcher-agent/Agents-Manage/runner/runner.py
# AM_DATA_HOST=D:/2.Develop/5.Codex/researcher-agent/Agents-Manage/.local/am-data
# AM_SIM_ENV=SIM_MODE=ok,TRADINGAGENTS_CHECKPOINT_ENABLED=true

# ---- 可选调优(默认值见 app/config.py)----
# AM_WATCHDOG_MINUTES=120
# AM_STALE_MINUTES=20
# AM_RETENTION_DAYS=90
# AM_STATUS_POLL_SECONDS=5
# AM_STOP_TIMEOUT=20
